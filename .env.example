# ===========================================
# Gossiplog - Environment Variables
# ===========================================
# 이 파일을 복사하여 .env로 저장하고 값을 설정하세요.
# cp .env.example .env

# ------------------------------------------
# [선택] Database (기본값 제공)
# ------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gossiplog_local
DB_USERNAME=gossiplog
DB_PASSWORD=gossiplog123

# ------------------------------------------
# [선택] Valkey/Redis (기본값 제공)
# ------------------------------------------
VALKEY_HOST=localhost
VALKEY_PORT=6379
# VALKEY_PASSWORD=        # 로컬 환경에서는 비밀번호 불필요

# ------------------------------------------
# [선택] Logging (기본값: INFO)
# ------------------------------------------
LOGGING_LEVEL_ROOT=INFO
