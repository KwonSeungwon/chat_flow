# Search Service - Local Development Environment (TEMPLATE)
#
# This file is tracked. The actual `application-local.yml` is gitignored
# (root .gitignore line 34). On a fresh checkout, copy this template:
#
#   cp search-service/src/main/resources/application-local.yml.example \
#      search-service/src/main/resources/application-local.yml
#
# IMPORTANT — Kafka value-deserializer:
#   The consumer value-deserializer MUST be StringDeserializer (not
#   JsonDeserializer). The listener container factory in common
#   (KafkaCommonConfig) deserializes the JSON payload itself; a
#   JsonDeserializer here double-deserializes and fails at runtime.
server:
  port: 8082

spring:
  profiles:
    active: local

  elasticsearch:
    uris: http://localhost:9200
    connection-timeout: 1s
    socket-timeout: 30s

  kafka:
    bootstrap-servers: localhost:9092
    consumer:
      group-id: search-service-local-group
      key-deserializer: org.apache.kafka.common.serialization.StringDeserializer
      value-deserializer: org.apache.kafka.common.serialization.StringDeserializer

management:
  endpoints:
    web:
      exposure:
        include: health,info,metrics,prometheus
  endpoint:
    health:
      show-details: always
  tracing:
    sampling:
      probability: 1.0
  zipkin:
    tracing:
      endpoint: http://localhost:9411/api/v2/spans

rss:
  feed-url: https://www-swpro-com.tistory.com/rss
  crawl-interval: 3600000  # 1시간 (ms)

logging:
  level:
    com.chatflow: DEBUG
    co.elastic.clients: DEBUG
